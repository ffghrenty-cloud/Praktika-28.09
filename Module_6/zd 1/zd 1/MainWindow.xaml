<Window x:Class="BibliotekaWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека" Height="620" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Библиотека" FontSize="28" FontWeight="Bold" Foreground="#20324D"/>
            <TextBlock Text="Каталог книг: поиск, добавление и удаление" FontSize="14" Foreground="#667085" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Найти" Click="Search_Click" MinWidth="80"/>
                    <Button Content="Сбросить" Click="ResetSearch_Click" MinWidth="85"/>
                </StackPanel>
                <TextBox x:Name="SearchTextBox" Margin="0,0,12,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Введите название книги или автора"
                         TextChanged="SearchTextBox_TextChanged"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="BooksGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single"
                  SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White" BorderBrush="#D9E0EA"
                  RowHeight="36" ColumnHeaderHeight="38"
                  AlternatingRowBackground="#F8FAFC"
                  Margin="0,0,0,14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="55"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="2*"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*"/>
                <DataGridTextColumn Header="Год издания" Binding="{Binding Year}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button Content="Добавить книгу" Click="AddBook_Click" Background="#315C9B" Foreground="White"/>
                <Button Content="Удалить книгу" Click="DeleteBook_Click"/>
                <Button Content="Арендовать" Click="RentBook_Click"/>
                <Button Content="Вернуть" Click="ReturnBook_Click"/>
            </WrapPanel>
            <TextBlock x:Name="CountTextBlock" Grid.Column="1" VerticalAlignment="Center"
                       Foreground="#667085" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
