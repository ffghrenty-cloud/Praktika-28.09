<Window x:Class="BibliotekaWPF.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление книги" Height="390" Width="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Новая книга" FontSize="23" FontWeight="Bold"
                   Foreground="#20324D" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Название"/>
            <TextBox x:Name="TitleBox"/>
            <TextBlock Text="Автор"/>
            <TextBox x:Name="AuthorBox"/>
            <TextBlock Text="Жанр"/>
            <TextBox x:Name="GenreBox"/>
            <TextBlock Text="Год издания"/>
            <TextBox x:Name="YearBox" MaxLength="4"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" Click="Cancel_Click" MinWidth="90"/>
            <Button Content="Сохранить" Click="Save_Click" MinWidth="100"
                    Background="#315C9B" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
